# ─────────────────────────────
# Facturación Electrónica OPCIONAL con Siigo (DIAN - Colombia)
# Copia este archivo a `.env` en la raíz del proyecto y completa los valores.
# El `.env` NO debe subirse al repositorio (contiene credenciales).
# ─────────────────────────────

# Credenciales de la API de Siigo (https://siigoapi.docs.apiary.io).
SIIGO_USERNAME=tu_usuario_siigo
SIIGO_ACCESS_KEY=tu_access_key_siigo

# IP estática autorizada por Siigo. El tráfico debe salir por un proxy estático.
# Configura UNA de las dos (Fixie o QuotaGuard). Ejemplo Fixie:
FIXIE_URL=http://usuario:password@proxy.fixie.io:8080
# o QuotaGuard Static:
# QUOTAGUARDSTATIC_URL=http://usuario:password@proxy.quotaguardstatic.com:9293

# Host de la API (no cambiar salvo entorno de pruebas).
SIIGO_API_BASE=https://api.siigo.com
SIIGO_PARTNER_ID=FerreteriaPOS

# Códigos de la configuración tributaria de tu cuenta Siigo.
# IMPORTANTE: deben existir en Siigo y coincidir con tu resolución de facturación.
SIIGO_DOCUMENT_ID=1
SIIGO_DOCUMENT_TYPE=Invoice
# Vendedor por defecto (0 = usar el del token).
SIIGO_SELLER_ID=0

# Impuesto por defecto de los productos (0 = sin IVA explícito).
SIIGO_TAX_ID=0
SIIGO_TAX_PERCENTAGE=0

# Formas de pago: mapea cada medio del POS al `payment.id` configurado en Siigo.
SIIGO_PAYMENT_ID=1
SIIGO_PAYMENT_EFECTIVO=1
SIIGO_PAYMENT_TRANSFERENCIA=1
SIIGO_PAYMENT_TARJETA=1
SIIGO_PAYMENT_CREDITO=1

# Tiempos de espera y reintentos.
SIIGO_TIMEOUT=30
SIIGO_MAX_REINTENTOS=2
