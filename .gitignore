__pycache__/
*.pyc
*.pyo

# Respaldos locales de la base de datos (no deben ir al repositorio)
ferreteria-respaldo-*.db
ferreteria-respaldo-*.db-journal
*.db-wal
*.db-shm
# La base de datos en si: contiene datos de operacion (ventas, clientes,
# usuarios). No debe versionarse, para que un commit no borre informacion real
# de otros y las credenciales/datos no viajen al repositorio. La app la crea y
# siembra sola al arrancar (ferreteria/db.py: asegurar_base_de_datos).
ferreteria.db

# Entornos virtuales
venv/
.venv/

# Variables de entorno
.env
# Residuos y archivos de trabajo temporales
*.obsoleto-*
# Scripts locales de verificacion (no son parte de la app)
_test_*.py
_ver_*.py
_probar_*.py
_chk_*.py
_verif_*.py
# Logs del servidor de desarrollo
_server_*.log
_salida_test.log
_render_tmp.html
# Dependencias de Node (Playwright y scripts de QA)
node_modules/
# Pruebas de QA con navegador (locales, requieren Playwright)
_qa_*.mjs
# Scripts de un solo uso ya aplicados
_borrar_*.py
_fix_*.py
_validar_js.mjs
